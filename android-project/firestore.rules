rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validCustomer(data, documentId) {
      return data.keys().hasAll([
          'customerId', 'fullName', 'phoneNumber', 'dateOfBirth',
          'email', 'address', 'createdAt'
        ])
        && data.keys().hasOnly([
          'customerId', 'fullName', 'phoneNumber', 'dateOfBirth',
          'email', 'address', 'createdAt'
        ])
        && data.customerId is string
        && data.customerId == documentId
        && data.fullName is string
        && data.fullName.size() >= 2
        && data.fullName.size() <= 100
        && data.phoneNumber is string
        && data.phoneNumber.matches('^[6-9][0-9]{9}$')
        && data.dateOfBirth is string
        && data.dateOfBirth.matches('^(0[1-9]|[12][0-9]|3[01])/(0[1-9]|1[0-2])/(19|20)[0-9]{2}$')
        && data.email is string
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.address is string
        && data.address.size() >= 5
        && data.address.size() <= 400
        && data.createdAt is timestamp;
    }

    match /customers/{customerId} {
      allow read: if signedIn();

      allow create: if signedIn()
                    && validCustomer(request.resource.data, customerId)
                    && request.resource.data.createdAt == request.time;

      allow update: if signedIn()
                    && validCustomer(request.resource.data, customerId)
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
